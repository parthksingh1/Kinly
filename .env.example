# Kinly configuration. Copy to .env (never commit .env).
# One file configures both the companion server (Python) and the family app (Next.js).
# Everything is optional for a local demo: without keys Kinly uses its offline brain,
# Edge TTS, browser speech recognition, demo billing and peer-to-peer video.

# ---- LLM (any OpenAI compatible endpoint: Gemini, OpenAI, Groq, Together, OpenRouter, vLLM...)
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-3.5-flash-lite
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1                                  LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# ---- Speech
DEEPGRAM_API_KEY=            # global languages, speech to text (Nova-3)
CARTESIA_API_KEY=            # global languages, text to speech (Sonic) + consented voice cloning
CARTESIA_VOICE_ID=           # optional: a warm voice id from the Cartesia library
SARVAM_API_KEY=              # Indian languages, speech to text (Saaras) and text to speech (Bulbul)
KINLY_SPEECH_RATE=0.9        # slower, clearer speech for older adults (0.6 - 1.5)

# ---- Phone (Bolna)
BOLNA_API_KEY=
BOLNA_AGENT_ID=              # printed by scripts/setup_bolna_agent.py
BOLNA_FROM_NUMBER=           # optional: your Bolna number in E.164 format

# ---- Video calls (LiveKit Cloud). Without these, Kinly uses peer-to-peer WebRTC.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Payments (Stripe test mode). Without these, plans activate in demo mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLAN_CURRENCY=USD            # USD or INR
# PRICE_CARE_USD=19  PRICE_FAMILY_USD=39  PRICE_PREMIUM_USD=69  PRICE_CARE_INR=999 ...

# ---- Notifications
WHATSAPP_PROVIDER=           # meta | twilio
WHATSAPP_TOKEN=              # Meta Cloud API token
WHATSAPP_PHONE_ID=           # Meta Cloud API phone number id
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
RESEND_API_KEY=
EMAIL_FROM=Kinly <onboarding@resend.dev>

# ---- Platform
PUBLIC_BASE_URL=http://localhost:12393      # public URL of the companion server (Bolna calls it)
APP_URL=http://localhost:3000               # public URL of the family app (links in messages)
FAMILY_APP_URL=http://localhost:3000
KINLY_API_URL=http://localhost:12393        # how the family app reaches the companion server
KINLY_API_TOKEN=change-me-to-a-long-random-string
AUTH_SECRET=change-me-to-another-long-random-string
NEXT_PUBLIC_KINLY_WS_URL=                   # default ws://<host>:12393/client-ws
DEMO_MODE=true
DEMO_ELDER_PHONE=                            # your phone, to receive the demo check-in call
DEMO_FAMILY_PHONE=                           # your WhatsApp number, to receive demo alerts
