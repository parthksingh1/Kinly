{
  "name": "family-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:schema-sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > ../src/kinly/schema.sql",
    "db:sync": "npm run db:push && npm run db:schema-sql",
    "seed": "tsx prisma/seed.ts",
    "setup": "npm run db:push && npm run seed",
    "predev": "node scripts/copy-vad-assets.mjs",
    "prebuild": "node scripts/copy-vad-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.14",
    "@livekit/components-styles": "^1.1.6",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.16.2",
    "@ricky0123/vad-web": "^0.0.27",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "livekit-client": "^2.15.7",
    "livekit-server-sdk": "^2.13.3",
    "next": "15.5.4",
    "onnxruntime-web": "^1.22.0",
    "prisma": "^6.16.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.2.1",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
