// Kinly shared data model.
// The family app (Next.js) and the companion backend (Python) share one database.
// SQLite for the hackathon; switch `provider` to "postgresql" for production.
// After editing, run `npm run db:sync` which also regenerates src/kinly/schema.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  isAdmin      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  memberships  FamilyMember[]

  @@map("users")
}

model Family {
  id                   String         @id @default(cuid())
  name                 String
  plan                 String         @default("trial") // trial | care | family | premium
  planStatus           String         @default("trialing") // trialing | active | past_due | canceled
  currency             String         @default("USD")
  trialEndsAt          DateTime?
  billingProvider      String?        // stripe | razorpay | demo
  billingCustomerId    String?
  billingSubscriptionId String?
  createdAt            DateTime       @default(now())
  members              FamilyMember[]
  elders               Elder[]
  invites              Invite[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@map("families")
}

model FamilyMember {
  id             String   @id @default(cuid())
  familyId       String
  userId         String
  role           String   @default("member") // owner | member
  relation       String   @default("") // son, daughter, granddaughter...
  phone          String   @default("")
  notifyWhatsapp Boolean  @default(true)
  notifyEmail    Boolean  @default(true)
  createdAt      DateTime @default(now())
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_members")
}

model Invite {
  id         String    @id @default(cuid())
  familyId   String
  email      String
  role       String    @default("member")
  relation   String    @default("")
  token      String    @unique
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("invites")
}

model Elder {
  id                String    @id @default(cuid())
  familyId          String
  name              String
  preferredName     String
  age               Int?
  gender            String    @default("") // female | male | "" (used for gendered grammar, e.g. Hindi)
  languages        String    @default("en") // comma separated ISO codes, first is primary
  phone             String    @default("")
  timezone          String    @default("Asia/Kolkata")
  city              String    @default("")
  about             String    @default("") // free text from family: likes, routines, health notes
  screenToken       String    @unique
  consentStatus     String    @default("pending") // pending | granted | declined
  consentAt         DateTime?
  consentChannel    String?
  consentTranscript String?
  emergencyNumber   String    @default("112")
  isDemo            Boolean   @default(false)
  lastActiveAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  family            Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  callSchedules     CallSchedule[]
  medicines         Medicine[]
  medicineLogs      MedicineLog[]
  appointments      Appointment[]
  contacts          Contact[]
  conversations     Conversation[]
  memories          Memory[]
  alerts            Alert[]
  summaries         DailySummary[]
  voiceMessages     VoiceMessage[]
  videoCalls        VideoCall[]
  chapters          MemoryBookChapter[]
  phoneCalls        PhoneCall[]
  avatars           FamilyAvatar[]
  turnMetrics       TurnMetric[]

  @@map("elders")
}

model CallSchedule {
  id        String   @id @default(cuid())
  elderId   String
  timeLocal String // "10:00" in the elder's timezone
  days      String   @default("daily") // daily | mon,tue,...
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  elder     Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("call_schedules")
}

model Medicine {
  id           String        @id @default(cuid())
  elderId      String
  name         String
  dosage       String        @default("")
  instructions String        @default("")
  times        String // "09:00,21:00" in the elder's timezone
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  elder        Elder         @relation(fields: [elderId], references: [id], onDelete: Cascade)
  logs         MedicineLog[]

  @@map("medicines")
}

model MedicineLog {
  id            String    @id @default(cuid())
  elderId       String
  medicineId    String
  scheduledFor  DateTime
  status        String    @default("pending") // pending | taken | missed | skipped
  confirmedAt   DateTime?
  source        String? // screen | phone | family | auto
  remindedCount Int       @default(0)
  createdAt     DateTime  @default(now())
  elder         Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)
  medicine      Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([medicineId, scheduledFor])
  @@map("medicine_logs")
}

model Appointment {
  id         String    @id @default(cuid())
  elderId    String
  title      String
  location   String    @default("")
  startsAt   DateTime
  notes      String    @default("")
  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  elder      Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Contact {
  id          String   @id @default(cuid())
  elderId     String
  userId      String?
  name        String
  relation    String   @default("")
  phone       String   @default("")
  email       String   @default("")
  photoUrl    String   @default("")
  isEmergency Boolean  @default(false)
  createdAt   DateTime @default(now())
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Conversation {
  id              String    @id @default(cuid())
  elderId         String
  channel         String // screen | phone | demo
  externalId      String?   @unique // e.g. Bolna execution id
  startedAt       DateTime
  endedAt         DateTime?
  durationSec     Int       @default(0)
  language        String    @default("en")
  languagesUsed   String    @default("")
  transcript      String    @default("[]") // JSON [{role, text, at, private}]
  summary         String    @default("")
  mood            Int? // 1 (very low) .. 5 (very good)
  moodLabel       String    @default("")
  topics          String    @default("[]") // JSON array of strings
  processed       Boolean   @default(false)
  turnCount       Int       @default(0)
  avgFirstAudioMs Int?
  createdAt       DateTime  @default(now())
  elder           Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("conversations")
}

model Memory {
  id             String    @id @default(cuid())
  elderId        String
  kind           String // family | life_story | routine | like | dislike | health | preference | event | other
  subject        String    @default("")
  content        String
  private        Boolean   @default(false)
  importance     Int       @default(2) // 1..3
  conversationId String?
  forgotten      Boolean   @default(false)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  elder          Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("memories")
}

model Alert {
  id             String    @id @default(cuid())
  elderId        String
  severity       String // urgent | concerning | info
  category       String // fall | chest_pain | breathing | confusion | self_harm | low_mood | not_eating | loneliness | missed_medicine | missed_call | scam | other
  title          String
  detail         String    @default("")
  quote          String    @default("")
  status         String    @default("open") // open | acknowledged | resolved
  conversationId String?
  notifiedAt     DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  elder          Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model DailySummary {
  id         String    @id @default(cuid())
  elderId    String
  date       String // YYYY-MM-DD in the elder's timezone
  summary    String
  mood       Int?
  moodLabel  String    @default("")
  topics     String    @default("[]")
  medsTaken  Int       @default(0)
  medsMissed Int       @default(0)
  followUps  String    @default("[]")
  talkAbout  String    @default("[]")
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  elder      Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@unique([elderId, date])
  @@map("daily_summaries")
}

model VoiceMessage {
  id          String    @id @default(cuid())
  elderId     String
  direction   String // to_elder | from_elder
  fromName    String
  fromUserId  String?
  audioPath   String
  mimeType    String    @default("audio/webm")
  durationSec Int       @default(0)
  transcript  String    @default("")
  playedAt    DateTime?
  createdAt   DateTime  @default(now())
  elder       Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("voice_messages")
}

model VideoCall {
  id          String       @id @default(cuid())
  elderId     String
  roomName    String       @unique
  provider    String // livekit | p2p
  initiatedBy String // elder | family
  contactId   String?
  contactName String       @default("")
  status      String       @default("ringing") // ringing | active | ended | missed | declined
  answeredAt  DateTime?
  endedAt     DateTime?
  createdAt   DateTime     @default(now())
  elder       Elder        @relation(fields: [elderId], references: [id], onDelete: Cascade)
  signals     CallSignal[]

  @@map("video_calls")
}

model CallSignal {
  id        String    @id @default(cuid())
  callId    String
  sender    String // elder | family
  kind      String // offer | answer | candidate | hangup
  payload   String
  createdAt DateTime  @default(now())
  call      VideoCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_signals")
}

model MemoryBookChapter {
  id        String   @id @default(cuid())
  elderId   String
  title     String
  era       String   @default("")
  body      String
  sources   String   @default("[]") // JSON memory ids
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  elder     Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("memory_book_chapters")
}

model PhoneCall {
  id             String    @id @default(cuid())
  elderId        String
  direction      String // outbound | inbound
  reason         String    @default("checkin") // checkin | reminder | demo | inbound
  status         String    @default("scheduled") // scheduled | queued | ringing | in-progress | completed | no-answer | busy | failed | canceled
  scheduledFor   DateTime
  attempt        Int       @default(1)
  executionId    String?   @unique
  conversationId String?
  error          String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  elder          Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("phone_calls")
}

model FamilyAvatar {
  id                String    @id @default(cuid())
  elderId           String
  userId            String // the adult being represented; only they can create it
  displayName       String
  relation          String    @default("")
  photoPath         String    @default("")
  consentAudioPath  String    @default("")
  consentTranscript String    @default("")
  consentAt         DateTime?
  adultConfirmed    Boolean   @default(false)
  ownerApprovedAt   DateTime?
  ownerUserId       String?
  elderInformedAt   DateTime?
  enabled           Boolean   @default(false)
  voiceProvider     String    @default("")
  voiceId           String    @default("")
  status            String    @default("draft") // draft | consented | active | revoked
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  elder             Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("family_avatars")
}

model Notification {
  id        String   @id @default(cuid())
  familyId  String
  elderId   String?
  channel   String // whatsapp | email | dashboard
  recipient String
  subject   String   @default("")
  body      String
  status    String // sent | failed | logged
  provider  String   @default("")
  error     String   @default("")
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  familyId    String
  elderId     String?
  actorUserId String?
  action      String
  detail      String   @default("{}")
  createdAt   DateTime @default(now())
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model TurnMetric {
  id           String   @id @default(cuid())
  elderId      String?
  channel      String // screen | phone
  firstAudioMs Int
  asrProvider  String   @default("")
  ttsProvider  String   @default("")
  language     String   @default("")
  createdAt    DateTime @default(now())
  elder        Elder?   @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("turn_metrics")
}
